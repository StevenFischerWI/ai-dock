{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Dock",
  "version": "0.1.0",
  "identifier": "com.aidock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dock",
        "title": "AI Dock",
        "url": "index.html",
        "width": 1200,
        "height": 40,
        "minHeight": 32,
        "maxHeight": 64,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "editor",
        "title": "AI Dock Session",
        "url": "index.html",
        "width": 520,
        "height": 540,
        "minWidth": 420,
        "minHeight": 430,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "launcher",
        "title": "AI Dock Start",
        "url": "index.html",
          "width": 420,
          "height": 380,
          "minWidth": 420,
          "minHeight": 380,
          "maxWidth": 420,
          "maxHeight": 380,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "rename",
        "title": "Rename terminal tab",
        "url": "index.html",
        "width": 380,
        "height": 142,
        "minWidth": 380,
        "minHeight": 142,
        "maxWidth": 380,
        "maxHeight": 142,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "color",
        "title": "Choose terminal tab color",
        "url": "index.html",
        "width": 380,
        "height": 174,
        "minWidth": 380,
        "minHeight": 174,
        "maxWidth": 380,
        "maxHeight": 174,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "zenplan-editor",
        "title": "Pin web app",
        "url": "index.html",
        "width": 480,
        "height": 218,
        "minWidth": 420,
        "minHeight": 218,
        "maxHeight": 218,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "window-apps",
        "title": "Apps shown in dock",
        "url": "index.html",
        "width": 420,
        "height": 480,
        "minWidth": 340,
        "minHeight": 300,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
