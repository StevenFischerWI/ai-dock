{
  "name": "ai-dock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 check",
    "desktop:lint": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 clippy",
    "desktop:dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 dev",
    "desktop:dev:isolated": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 dev-isolated",
    "desktop:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 build",
    "desktop:build:cutover": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 build-cutover",
    "desktop:build:isolated": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 build-isolated",
    "desktop:test": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.4.3"
  }
}
